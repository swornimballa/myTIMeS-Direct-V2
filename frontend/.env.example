# Copy this file to .env and fill in your real values. NEVER commit .env to Git.

# --- Backend API ---
# Android Emulator: http://10.0.2.2:5000/api/v1
# Physical device: http://<your-LAN-IP>:5000/api/v1
# iOS Simulator: http://localhost:5000/api/v1
FLASK_BASE_URL=http://10.0.2.2:5000/api/v1

# --- Firebase (get these from Firebase Console → Project Settings → Your Apps) ---
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
